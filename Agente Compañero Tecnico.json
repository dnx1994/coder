    {
      "parameters": {
        "jsCode": "// Obtiene los datos de ambas consultas de Airtable de forma independiente\nconst historial = $('cunsulta historial1').all();\nconst lowMemory = $('Search LowMemory').all();\n\nreturn [{\n  json: {\n    // Lista compacta del historial (segura si está vacía)\n    historial_compacto: historial.length > 0 \n      ? historial.map(item => ({\n          message: item.json?.fields?.message ?? null,\n          response: item.json?.fields?.response ?? null,\n          created_on: item.json?.fields?.created_on ?? null\n        })) \n      : [],\n      \n    // Datos provenientes del registro de LowMemory (segura si está vacía)\n    low_memory_data: lowMemory.length > 0 \n      ? lowMemory.map(item => ({\n          id: item.json?.id ?? null,\n          asunto_principal: item.json?.fields?.asunto_principal ?? null,\n          puntos_clave: item.json?.fields?.puntos_clave ?? null,\n          accion_requerida: item.json?.fields?.accion_requerida ?? null,\n          session_id: item.json?.fields?.Session_ID ?? null\n        })) \n      : []\n  }\n}];"
      },
