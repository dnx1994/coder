      "parameters": {
        "jsCode": "// 1. Obtener el texto que devuelve el nodo 'AI Agent'\nconst rawText = $json.output || \"\";\nlet reintento =0;\n// 2. Limpiar bloques de código Markdown (```json y ```) y saltos de línea\nlet cleaned = rawText\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet cod_articulo = null;\nlet cod_local = null;\n\ntry {\n  // 3. Parsear el string a un objeto JSON\n  const parsed = JSON.parse(cleaned);\n  \n  // 4. Asegurar que \"null\" en string pase a ser null nativo\n  cod_articulo = (parsed.cod_articulo === 'null' || parsed.cod_articulo === undefined) ? null : parsed.cod_articulo;\n  cod_local = (parsed.cod_local === 'null' || parsed.cod_local === undefined) ? null : parsed.cod_local;\n\n} catch (error) {\n  // Si no viene un JSON válido, quedan en null\n}\n\n// 5. Retornar el objeto listo para n8n\nreturn {\n  cod_articulo,\n  cod_local,\n  reintento\n};"
